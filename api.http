##################### Orders #####################
###
GET http://localhost:8000/api/orders/
Accept: application/json
###

GET http://localhost:8000/api/orders/3/
Accept: application/json
###

POST http://localhost:8000/api/orders/
Content-Type: application/json

{
    "portfolio" : 2,
    "order_type" : "BUY",
    "symbol" : "AAPL",
    "status" : "Pending",
    "quantity" : 5,
    "price" : 250
}
###

PUT http://localhost:8000/api/orders/14/
Content-Type: application/json

{
    "portfolio" : 2, 
    "order_type" : "BUY",
    "symbol" : "AAPL",
    "status" : "Confirmed",
    "quantity" : 5,
    "price" : 250
}
###

PATCH http://localhost:8000/api/orders/3/
Content-Type: application/json

{
    "status" : "Complete",
    "quantity" : 3,
    "price" : 250
}
